connection node_2;
connection node_1;
call mtr.add_suppression("Plugin 'TIDESDB' is of maturity level");
connection node_2;
call mtr.add_suppression("Plugin 'TIDESDB' is of maturity level");
connect  node_1b, 127.0.0.1, root, , test, $NODE_MYPORT_1;
connection node_1;
CREATE TABLE t (id INT PRIMARY KEY, v INT) ENGINE=TidesDB;
INSERT INTO t VALUES (1, 0), (2, 0);
connection node_2;
#
# 1. A statement that fails inside the transaction
#
connection node_1b;
SET SESSION TRANSACTION ISOLATION LEVEL SERIALIZABLE;
START TRANSACTION;
SELECT v FROM t WHERE id = 1;
v
0
INSERT INTO t VALUES (2, 9);
ERROR 23000: Duplicate entry '2' for key 'PRIMARY'
connection node_2;
UPDATE t SET v = 1 WHERE id = 1;
connection node_1;
connection node_1b;
COMMIT;
Got one of the listed errors
#
# 2. A rollback to a savepoint taken after the read
#
connection node_1b;
START TRANSACTION;
SELECT v FROM t WHERE id = 2;
v
0
SAVEPOINT s;
UPDATE t SET v = 5 WHERE id = 1;
ROLLBACK TO SAVEPOINT s;
connection node_2;
UPDATE t SET v = 2 WHERE id = 2;
connection node_1;
connection node_1b;
COMMIT;
Got one of the listed errors
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
#
# Both nodes are up and agree
#
connection node_1;
SELECT id, v FROM t ORDER BY id;
id	v
1	1
2	2
SHOW STATUS LIKE 'wsrep_local_state_comment';
Variable_name	Value
wsrep_local_state_comment	Synced
connection node_2;
SELECT id, v FROM t ORDER BY id;
id	v
1	1
2	2
SHOW STATUS LIKE 'wsrep_local_state_comment';
Variable_name	Value
wsrep_local_state_comment	Synced
disconnect node_1b;
connection node_1;
DROP TABLE t;
disconnect node_2;
disconnect node_1;
