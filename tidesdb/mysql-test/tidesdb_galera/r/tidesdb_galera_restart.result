connection node_2;
connection node_1;
call mtr.add_suppression("Plugin 'TIDESDB' is of maturity level");
call mtr.add_suppression("WSREP: gcs_caused\\(\\) returned -(107|1) ");
connection node_2;
call mtr.add_suppression("Plugin 'TIDESDB' is of maturity level");
connection node_1;
CREATE TABLE t (id INT PRIMARY KEY, v INT) ENGINE=TidesDB;
INSERT INTO t VALUES (1, 1), (2, 2);
connection node_2;
#
# 1. A clean shutdown after TidesDB commits
#
connection node_1;
INSERT INTO t VALUES (3, 3);
UPDATE t SET v = 20 WHERE id = 2;
connection node_2;
# restart
SELECT id, v FROM t ORDER BY id;
id	v
1	1
2	20
3	3
#
# 2. A crash after TidesDB commits
#
connection node_2;
INSERT INTO t VALUES (4, 4);
connection node_1;
connection node_2;
Killing server ...
# a crashed peer leaves the survivor of a two node cluster without quorum, so it is made
# primary again on its own
connection node_1;
SET SESSION wsrep_sync_wait = 0;
SET GLOBAL wsrep_provider_options = 'pc.bootstrap=YES';
SET SESSION wsrep_sync_wait = DEFAULT;
INSERT INTO t VALUES (5, 5);
DELETE FROM t WHERE id = 1;
connection node_2;
# restart
SELECT id, v FROM t ORDER BY id;
id	v
2	20
3	3
4	4
5	5
#
# Both nodes hold the same rows, and keep replicating
#
connection node_1;
INSERT INTO t VALUES (6, 6);
SELECT id, v FROM t ORDER BY id;
id	v
2	20
3	3
4	4
5	5
6	6
connection node_2;
SELECT id, v FROM t ORDER BY id;
id	v
2	20
3	3
4	4
5	5
6	6
connection node_1;
DROP TABLE t;
disconnect node_2;
disconnect node_1;
