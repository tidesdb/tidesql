# Every read a transaction at SERIALIZABLE makes is claimed when the transaction prepares, and a
# prepared claim refuses any write to what it covers, an applier's included, so an applier that
# writes inside such a claim has to abort the reader first rather than be refused by it.  Each path
# the engine reads through is taken in turn, a point read by primary key, a bounded scan of a
# secondary index, a scan of the whole table, and the parent lookup of a foreign key check, with
# the other node then writing inside what was read.  The reader is aborted, the node stays up, and
# both nodes agree.
--source include/galera_cluster.inc
--source include/have_innodb.inc

call mtr.add_suppression("Plugin 'TIDESDB' is of maturity level");
--connection node_2
call mtr.add_suppression("Plugin 'TIDESDB' is of maturity level");

--connect (node_1b, 127.0.0.1, root, , test, $NODE_MYPORT_1)

--connection node_1
CREATE TABLE t (id INT PRIMARY KEY, v INT, k INT, KEY (k)) ENGINE=TidesDB;
INSERT INTO t VALUES (1, 0, 1), (2, 0, 2), (3, 0, 3), (4, 0, 4);
CREATE TABLE p (id INT PRIMARY KEY) ENGINE=TidesDB;
CREATE TABLE c (id INT PRIMARY KEY, pid INT NOT NULL, KEY (pid),
                FOREIGN KEY (pid) REFERENCES p (id)) ENGINE=TidesDB;
INSERT INTO p VALUES (1), (2);
--connection node_2
--let $wait_condition= SELECT COUNT(*) = 2 FROM p;
--source include/wait_condition.inc

--echo #
--echo # 1. A point read by primary key
--echo #
--connection node_1b
SET SESSION TRANSACTION ISOLATION LEVEL SERIALIZABLE;
START TRANSACTION;
SELECT v FROM t WHERE id = 1;
--connection node_2
UPDATE t SET v = 1 WHERE id = 1;
--connection node_1
--let $wait_condition= SELECT v = 1 FROM t WHERE id = 1;
--source include/wait_condition.inc
--connection node_1b
--error ER_LOCK_DEADLOCK,ER_ERROR_DURING_COMMIT
COMMIT;

--echo #
--echo # 2. A bounded scan of a secondary index, with a row inserted inside the scanned range
--echo #
--connection node_1b
START TRANSACTION;
SELECT COUNT(*) FROM t WHERE k BETWEEN 2 AND 3;
--connection node_2
INSERT INTO t VALUES (5, 0, 2);
--connection node_1
--let $wait_condition= SELECT COUNT(*) = 5 FROM t;
--source include/wait_condition.inc
--connection node_1b
--error ER_LOCK_DEADLOCK,ER_ERROR_DURING_COMMIT
COMMIT;

--echo #
--echo # 3. A scan of the whole table, with a row inserted anywhere
--echo #
--connection node_1b
START TRANSACTION;
SELECT SUM(v) FROM t;
--connection node_2
INSERT INTO t VALUES (6, 0, 6);
--connection node_1
--let $wait_condition= SELECT COUNT(*) = 6 FROM t;
--source include/wait_condition.inc
--connection node_1b
--error ER_LOCK_DEADLOCK,ER_ERROR_DURING_COMMIT
COMMIT;

--echo #
--echo # 4. The parent lookup of a foreign key check, with the parent then deleted on the other node
--echo #
--connection node_1b
START TRANSACTION;
INSERT INTO c VALUES (1, 2);
--connection node_2
DELETE FROM p WHERE id = 2;
--connection node_1
--let $wait_condition= SELECT COUNT(*) = 1 FROM p;
--source include/wait_condition.inc
--connection node_1b
--error ER_LOCK_DEADLOCK,ER_ERROR_DURING_COMMIT
COMMIT;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;

--echo #
--echo # Both nodes are up and agree
--echo #
--connection node_1
SELECT id, v, k FROM t ORDER BY id;
SELECT id FROM p ORDER BY id;
SELECT COUNT(*) FROM c;
SHOW STATUS LIKE 'wsrep_local_state_comment';
--connection node_2
SELECT id, v, k FROM t ORDER BY id;
SELECT id FROM p ORDER BY id;
SELECT COUNT(*) FROM c;
SHOW STATUS LIKE 'wsrep_local_state_comment';

--disconnect node_1b
--connection node_1
DROP TABLE c, p, t;

--source include/galera_end.inc
