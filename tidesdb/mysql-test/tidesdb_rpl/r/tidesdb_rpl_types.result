include/master-slave.inc
[connection master]
call mtr.add_suppression("Plugin 'TIDESDB' is of maturity level");
connection slave;
call mtr.add_suppression("Plugin 'TIDESDB' is of maturity level");
connection master;
#
# 1. A wide column set with secondary indexes replicates and applies
#
CREATE TABLE wide (
id INT PRIMARY KEY,
i8 TINYINT, u8 TINYINT UNSIGNED, i64 BIGINT,
d DECIMAL(20,6), f DOUBLE,
c CHAR(8), v VARCHAR(64), t TEXT, b BLOB, bin VARBINARY(16),
dt DATETIME(3), ts TIMESTAMP(6) NULL, y YEAR,
e ENUM('a','b','c'), st SET('x','y','z'), j JSON,
KEY k_v (v), KEY k_d (d), KEY k_dt (dt)
) ENGINE=TidesDB;
Warnings:
Note	1071	Specified key was too long; max key length is 255 bytes
INSERT INTO wide VALUES
(1, -5, 200, 9000000000, 12345.678900, 3.5, 'char', 'varchar', 'text-a', 0x0102, 0xAABB,
'2023-01-02 03:04:05.678', '2023-06-07 08:09:10.111213', 2021, 'b', 'x,z', '{"k": 1}'),
(2, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
NULL, NULL, NULL, NULL, NULL, NULL);
UPDATE wide SET v = 'updated', d = 99999.999999, e = 'c', st = 'y' WHERE id = 1;
DELETE FROM wide WHERE id = 2;
INSERT INTO wide (id, v, d, dt) VALUES (3, 'three', 3.33, '2024-02-02 02:02:02.002');
connection slave;
connection slave;
# slave content and index-driven reads
SELECT id, i8, u8, i64, d, f, c, v, e, st, j FROM wide ORDER BY id;
id	i8	u8	i64	d	f	c	v	e	st	j
1	-5	200	9000000000	99999.999999	3.5	char	updated	c	y	{"k": 1}
3	NULL	NULL	NULL	3.330000	NULL	NULL	three	NULL	NULL	NULL
SELECT id, v FROM wide FORCE INDEX (k_v) WHERE v = 'updated';
id	v
1	updated
SELECT id FROM wide FORCE INDEX (k_d) WHERE d > 100 ORDER BY id;
id
1
#
# 2. A larger multi-statement transaction replicates atomically
#
connection master;
BEGIN;
UPDATE wide SET v = 'batched' WHERE id BETWEEN 1001 AND 1100;
COMMIT;
connection slave;
connection slave;
SELECT COUNT(*) AS total, SUM(id) AS sum_id FROM wide;
total	sum_id
202	220104
SELECT COUNT(*) AS batched FROM wide WHERE v = 'batched';
batched
100
#
# 3. A slave stop/start resumes replication with no loss
#
connection slave;
STOP SLAVE SQL_THREAD;
connection master;
INSERT INTO wide (id, v, d) VALUES (5000, 'while-stopped', 1.0);
UPDATE wide SET v = 'while-stopped-2' WHERE id = 5000;
connection slave;
START SLAVE SQL_THREAD;
connection master;
connection slave;
connection slave;
SELECT id, v FROM wide WHERE id = 5000;
id	v
5000	while-stopped-2
#
# 4. Master and slave tables are byte-for-byte identical
#
connection master;
connection slave;
connection slave;
connection master;
# extended checksums match on master and slave
connection master;
DROP TABLE wide;
connection slave;
include/rpl_end.inc
