# Row-based replication of a TidesDB table from master to slave.  Proves the
# engine both writes correct row events and applies them on the replica, for a
# primary-key table (fast rnd_pos apply) and a table without a user primary key
# (index or scan apply), across insert, update, delete, and a multi-row commit.
--source include/have_binlog_format_row.inc
--source include/master-slave.inc

call mtr.add_suppression("Plugin 'TIDESDB' is of maturity level");
--connection slave
call mtr.add_suppression("Plugin 'TIDESDB' is of maturity level");
--connection master

--echo #
--echo # 1. A primary-key table replicates insert, update, and delete
--echo #
CREATE TABLE t1 (id INT PRIMARY KEY, v INT, s VARCHAR(32)) ENGINE=TidesDB;
INSERT INTO t1 VALUES (1, 10, 'one'), (2, 20, 'two'), (3, 30, 'three');
UPDATE t1 SET v = 25, s = 'two-b' WHERE id = 2;
DELETE FROM t1 WHERE id = 3;
--sync_slave_with_master
--connection slave
--echo # slave rows after insert/update/delete
SELECT id, v, s FROM t1 ORDER BY id;
SELECT COUNT(*) AS n FROM t1;

--echo #
--echo # 2. A table without a user primary key also replicates correctly
--echo #
--connection master
CREATE TABLE t2 (a INT, b VARCHAR(16), KEY (a)) ENGINE=TidesDB;
INSERT INTO t2 VALUES (1, 'x'), (1, 'y'), (2, 'z');
UPDATE t2 SET b = 'Y' WHERE a = 1 AND b = 'y';
DELETE FROM t2 WHERE a = 2;
--sync_slave_with_master
--connection slave
--echo # slave rows for the pk-less table
SELECT a, b FROM t2 ORDER BY a, b;

--echo #
--echo # 3. A multi-row transaction replicates atomically
--echo #
--connection master
BEGIN;
INSERT INTO t1 VALUES (10, 100, 'ten'), (11, 110, 'eleven');
UPDATE t1 SET v = v + 1 WHERE id = 1;
COMMIT;
--sync_slave_with_master
--connection slave
SELECT id, v, s FROM t1 ORDER BY id;

--echo #
--echo # 4. Slave and master data are identical
--echo #
--connection master
--let $d1= query_get_value(CHECKSUM TABLE t1, Checksum, 1)
--sync_slave_with_master
--connection slave
--let $d2= query_get_value(CHECKSUM TABLE t1, Checksum, 1)
--connection master
if ($d1 != $d2) {
  --echo MISMATCH master=$d1 slave=$d2
}
if ($d1 == $d2) {
  --echo # checksums match on master and slave
}

--connection master
DROP TABLE t1, t2;
--sync_slave_with_master

--source include/rpl_end.inc
