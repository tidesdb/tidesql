--source include/have_tidesdb.inc
--source include/not_embedded.inc

#
# tidesdb_ft_stopword_table set in the configuration file used to show in SHOW VARIABLES while
# the default stop words stayed in use, since only SET GLOBAL ever read the table.  A SET GLOBAL
# naming a table that could not be read also took the new value, leaving the variable naming a
# table whose words were not in use.  The table is now read at startup, and an unreadable one is
# refused with the variable left as it was.
#

call mtr.add_suppression("\\[TIDESDB\\] Stop word table .* not found");
call mtr.add_suppression("\\[TIDESDB\\] ft_stopword_table format must be");
call mtr.add_suppression("\\[TIDESDB\\] tidesdb_ft_stopword_table .* could not be loaded at startup");

CREATE TABLE swords (value VARCHAR(30)) ENGINE=TIDESDB;
INSERT INTO swords VALUES ('zebra'), ('giraffe');

--echo # an unreadable table is refused and the variable keeps its value
--error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL tidesdb_ft_stopword_table = 'test/no_such_table';
--error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL tidesdb_ft_stopword_table = 'not_a_db_slash_table';
SELECT @@global.tidesdb_ft_stopword_table IS NULL AS still_default;

--echo # named in the configuration, the table is in use from startup
--let $restart_parameters= --tidesdb-ft-stopword-table=test/swords
--source include/restart_mysqld.inc
SELECT @@global.tidesdb_ft_stopword_table;
CREATE TABLE d (id INT PRIMARY KEY, body TEXT, FULLTEXT KEY fb (body)) ENGINE=TIDESDB;
INSERT INTO d VALUES (1, 'zebra stripes'), (2, 'giraffe necks'), (3, 'plain words');
SELECT id FROM d WHERE MATCH(body) AGAINST('zebra');
SELECT id FROM d WHERE MATCH(body) AGAINST('giraffe');
SELECT id FROM d WHERE MATCH(body) AGAINST('stripes');
DROP TABLE d;

--echo # a startup value that cannot be read keeps the defaults and the server starts
--let $restart_parameters= --tidesdb-ft-stopword-table=test/no_such_table
--source include/restart_mysqld.inc
CREATE TABLE d (id INT PRIMARY KEY, body TEXT, FULLTEXT KEY fb (body)) ENGINE=TIDESDB;
INSERT INTO d VALUES (1, 'zebra stripes');
SELECT id FROM d WHERE MATCH(body) AGAINST('zebra');
DROP TABLE d;

--let $restart_parameters=
--source include/restart_mysqld.inc
DROP TABLE swords;

--source include/cleanup_tidesdb.inc
