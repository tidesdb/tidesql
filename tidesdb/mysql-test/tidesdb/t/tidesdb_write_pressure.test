--source include/have_tidesdb.inc
#
# TidesDB write-pressure test at MTR scale (the heavy oltp_write_only load runs
# on a dedicated box, not here -- see the local-capacity note).  It exercises
# the write-only transaction pattern -- 4 UPDATEs + 1 DELETE + 1 INSERT, like
# sysbench oltp_write_only -- under rapid txn cycling and concurrency.  Under
# optimistic MVCC any transaction can fail its commit with TDB_ERR_CONFLICT
# (ERROR 1180), so every writer retries; the point is that the engine cycles
# begin/commit/free cleanly, keeps data and index consistent, and leaks nothing
# under ASAN's LeakSanitizer at shutdown.
#

# Conflicts and back-pressure are expected and retried, so suppress the noise.
call mtr.add_suppression("\\[TIDESDB\\].*TDB_ERR_CONFLICT");
call mtr.add_suppression("\\[TIDESDB\\].*TDB_ERR_LOCKED");
call mtr.add_suppression("\\[TIDESDB\\].*TDB_ERR_MEMORY_LIMIT");
call mtr.add_suppression("\\[TIDESDB\\].*unexpected TidesDB error");

--echo #
--echo # === Setup: sysbench-like schema ===
--echo #

CREATE TABLE sbtest1 (
  id  INT NOT NULL AUTO_INCREMENT,
  k   INT NOT NULL DEFAULT 0,
  c   CHAR(120) NOT NULL DEFAULT '',
  pad CHAR(60) NOT NULL DEFAULT '',
  PRIMARY KEY (id),
  KEY k_1 (k)
) ENGINE=TIDESDB;

CREATE TABLE sbtest2 (
  id  INT NOT NULL AUTO_INCREMENT,
  k   INT NOT NULL DEFAULT 0,
  c   CHAR(120) NOT NULL DEFAULT '',
  pad CHAR(60) NOT NULL DEFAULT '',
  PRIMARY KEY (id),
  KEY k_1 (k)
) ENGINE=TIDESDB;

--echo #
--echo # === Populate: 1000 rows per table ===
--echo #

--disable_query_log
--disable_result_log
let $i= 1;
while ($i <= 1000)
{
  eval INSERT INTO sbtest1 (k, c, pad) VALUES (FLOOR(RAND()*100000), REPEAT('a',120), REPEAT('b',60));
  eval INSERT INTO sbtest2 (k, c, pad) VALUES (FLOOR(RAND()*100000), REPEAT('a',120), REPEAT('b',60));
  inc $i;
}
--enable_result_log
--enable_query_log

SELECT COUNT(*) AS sbtest1_rows FROM sbtest1;
SELECT COUNT(*) AS sbtest2_rows FROM sbtest2;

# One oltp_write_only transaction against the given table, retried until it
# commits.  The offset spreads the touched rows so overlapping callers conflict.
# n_txns transactions run per call.
delimiter |;
CREATE PROCEDURE write_storm(IN which INT, IN offs INT, IN n_txns INT)
BEGIN
  DECLARE t INT DEFAULT 0;
  DECLARE committed INT;
  DECLARE tries INT;
  WHILE t < n_txns DO
    SET committed = 0;
    SET tries = 0;
    WHILE committed = 0 AND tries < 1000 DO
      BEGIN
        DECLARE CONTINUE HANDLER FOR 1180, 1213, 1205 SET committed = -1;
        SET committed = 1;
        SET tries = tries + 1;
        START TRANSACTION;
        IF which = 1 THEN
          UPDATE sbtest1 SET k = k + 1 WHERE id = 1 + ((t + offs) % 1000);
          UPDATE sbtest1 SET c = REPEAT('A',120) WHERE id = 1 + ((t + offs + 200) % 1000);
          UPDATE sbtest1 SET k = k - 1 WHERE id = 1 + ((t + offs + 400) % 1000);
          UPDATE sbtest1 SET c = REPEAT('B',120) WHERE id = 1 + ((t + offs + 600) % 1000);
          DELETE FROM sbtest1 WHERE id = 1 + ((t + offs + 800) % 1000);
          INSERT INTO sbtest1 (k, c, pad) VALUES (FLOOR(RAND()*100000), REPEAT('w',120), REPEAT('z',60));
        ELSE
          UPDATE sbtest2 SET k = k + 1 WHERE id = 1 + ((t + offs) % 1000);
          UPDATE sbtest2 SET c = REPEAT('E',120) WHERE id = 1 + ((t + offs + 200) % 1000);
          UPDATE sbtest2 SET k = k - 1 WHERE id = 1 + ((t + offs + 400) % 1000);
          UPDATE sbtest2 SET c = REPEAT('F',120) WHERE id = 1 + ((t + offs + 600) % 1000);
          DELETE FROM sbtest2 WHERE id = 1 + ((t + offs + 800) % 1000);
          INSERT INTO sbtest2 (k, c, pad) VALUES (FLOOR(RAND()*100000), REPEAT('w',120), REPEAT('z',60));
        END IF;
        COMMIT;
      END;
      IF committed = -1 THEN
        ROLLBACK;
        SET committed = 0;
      END IF;
    END WHILE;
    SET t = t + 1;
  END WHILE;
END|
delimiter ;|

--echo #
--echo # === TEST 1: Single-connection write-only storm (200 txns) ===
--echo #
--disable_result_log
CALL write_storm(1, 0, 200);
--enable_result_log
SELECT COUNT(*) AS after_single FROM sbtest1;

--echo #
--echo # === TEST 2: Concurrent write-only storm (4 connections, overlapping) ===
--echo #
connect (wr1, localhost, root,,);
connect (wr2, localhost, root,,);
connect (wr3, localhost, root,,);
connect (wr4, localhost, root,,);

--disable_result_log
connection wr1;
send CALL write_storm(1, 0, 100);
connection wr2;
send CALL write_storm(1, 100, 100);
connection wr3;
send CALL write_storm(2, 0, 100);
connection wr4;
send CALL write_storm(2, 100, 100);

connection wr1;
reap;
connection wr2;
reap;
connection wr3;
reap;
connection wr4;
reap;
--enable_result_log

connection default;

--echo #
--echo # === Verify data/index consistency after concurrent writes ===
--echo #
let $pk1 = `SELECT COUNT(*) FROM sbtest1`;
let $pk2 = `SELECT COUNT(*) FROM sbtest2`;
let $idx1 = `SELECT COUNT(*) FROM sbtest1 WHERE k >= 0 OR k < 0`;
let $idx2 = `SELECT COUNT(*) FROM sbtest2 WHERE k >= 0 OR k < 0`;
--disable_query_log
if ($pk1 != $idx1)
{
  --echo FAIL: sbtest1 PK count ($pk1) != index count ($idx1)
}
if ($pk2 != $idx2)
{
  --echo FAIL: sbtest2 PK count ($pk2) != index count ($idx2)
}
--enable_query_log
--echo PK/index consistency: OK

--echo #
--echo # === Cleanup ===
--echo #
disconnect wr1;
disconnect wr2;
disconnect wr3;
disconnect wr4;

connection default;
DROP PROCEDURE write_storm;
DROP TABLE sbtest1;
DROP TABLE sbtest2;

--source include/cleanup_tidesdb.inc
--echo # Done.
