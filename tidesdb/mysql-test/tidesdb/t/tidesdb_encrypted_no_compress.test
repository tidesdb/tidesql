--source include/have_tidesdb.inc
--source include/not_embedded.inc

#
# An encrypted table stores ciphertext in its data column family.  Ciphertext
# does not compress, so the engine forces the data CF's compression off even
# when the table selects a compression algorithm, avoiding wasted CPU on every
# flush and compaction.  Secondary-index CFs hold unencrypted comparable keys
# and keep the selected compression.
#
# The per-CF encoding pipeline is a library-internal detail recorded in the
# db-level binary manifest in TidesDB 10 (there is no per-CF config.ini any
# more), and the library's own cf_config tests cover the compression-off
# optimization.  Here we verify the user-facing contract the plugin owns: an
# encrypted, compression-selecting table creates, reports its options, and
# round-trips data through both the encrypted data CF and the compressed index
# CF, across TRUNCATE.
#

--echo #
--echo # ============================================
--echo # Encrypted table with a selected compression creates and reports it
--echo # ============================================
--echo #
CREATE TABLE enc_lz4 (
  id INT PRIMARY KEY,
  u  INT,
  v  VARCHAR(200),
  KEY k_u (u)
) ENGINE=TIDESDB `ENCRYPTED`=YES COMPRESSION='LZ4';

--echo # the table still reports the requested COMPRESSION option to the user
--replace_regex /`([A-Z0-9_]+)`='([^']*)'/`\1`=\2/
SHOW CREATE TABLE enc_lz4;

--echo #
--echo # ============================================
--echo # Control: a non-encrypted table with the same compression
--echo # ============================================
--echo #
CREATE TABLE plain_lz4 (
  id INT PRIMARY KEY,
  v  VARCHAR(200)
) ENGINE=TIDESDB COMPRESSION='LZ4';

--replace_regex /`([A-Z0-9_]+)`='([^']*)'/`\1`=\2/
SHOW CREATE TABLE plain_lz4;

--echo #
--echo # ============================================
--echo # Data round-trips through the encrypted data CF and the compressed index CF
--echo # ============================================
--echo #
INSERT INTO enc_lz4 VALUES (1, 10, 'alpha'), (2, 20, 'beta'), (3, 30, 'gamma');
UPDATE enc_lz4 SET v = 'delta' WHERE id = 2;
DELETE FROM enc_lz4 WHERE id = 3;
SELECT * FROM enc_lz4 ORDER BY id;
--echo # covering index scan on the compressed index CF
SELECT id FROM enc_lz4 WHERE u = 10;

--echo #
--echo # ============================================
--echo # Data still round-trips after TRUNCATE recreates the CFs
--echo # ============================================
--echo #
TRUNCATE TABLE enc_lz4;
INSERT INTO enc_lz4 VALUES (4, 40, 'epsilon'), (5, 50, 'zeta');
SELECT * FROM enc_lz4 ORDER BY id;
SELECT id FROM enc_lz4 WHERE u = 40;

DROP TABLE enc_lz4;
DROP TABLE plain_lz4;

--echo #
--source include/cleanup_tidesdb.inc
--echo # Done.
