--source include/have_tidesdb.inc
--source include/not_embedded.inc

#
# Rebuilding a table or one of its indexes keeps each row's expiry.  An ALTER TABLE that copies the
# table rewrote every row as a fresh insert, which started its expiry clock again, so a row due to
# expire soon got its full TTL back.  An inplace ADD INDEX wrote the new index entries with no
# expiry at all, so once the row expired, a query answered from that index alone still returned
# it.  Both now read the row's own deadline and write it unchanged.  Every wait is measured from a
# stored insert time, so a slow runner cannot change what is checked.
#

CREATE TABLE written_at (t BIGINT) ENGINE=Aria;

--echo #
--echo # ============================================
--echo # A table copy keeps each row's deadline
--echo # ============================================
--echo #
CREATE TABLE t (id INT PRIMARY KEY, v INT, KEY kv (v)) ENGINE=TIDESDB TTL=6;
INSERT INTO written_at VALUES (UNIX_TIMESTAMP());
INSERT INTO t VALUES (1, 10), (2, 20);
--echo # halfway to the deadline, a copy that reorders columns, then one forced with an index
--disable_result_log
SELECT SLEEP(GREATEST(0, t + 3 - UNIX_TIMESTAMP())) FROM written_at;
--enable_result_log
ALTER TABLE t ADD COLUMN w INT FIRST;
ALTER TABLE t ADD INDEX kw (w), FORCE;
--echo # a row written after the copies gets the table TTL from its own write
INSERT INTO t (w, id, v) VALUES (0, 3, 30);
--disable_result_log
SELECT SLEEP(GREATEST(0, t + 7 - UNIX_TIMESTAMP())) FROM written_at;
--enable_result_log
--echo # the first two rows expired on their original schedule, the third has not
SELECT id FROM t ORDER BY id;
SELECT id FROM t FORCE INDEX (kv) WHERE v > 0 ORDER BY id;
DROP TABLE t;
DELETE FROM written_at;

--echo #
--echo # ============================================
--echo # A TTL an ALTER sets applies to rows written after it
--echo # ============================================
--echo #
CREATE TABLE n (id INT PRIMARY KEY, v INT) ENGINE=TIDESDB;
INSERT INTO n VALUES (1, 10);
ALTER TABLE n TTL=2, FORCE;
INSERT INTO written_at VALUES (UNIX_TIMESTAMP());
INSERT INTO n VALUES (2, 20);
--disable_result_log
SELECT SLEEP(GREATEST(0, t + 4 - UNIX_TIMESTAMP())) FROM written_at;
--enable_result_log
SELECT id FROM n ORDER BY id;
DROP TABLE n;
DELETE FROM written_at;

--echo #
--echo # ============================================
--echo # An inplace ADD INDEX gives each entry its row's deadline
--echo # ============================================
--echo #
CREATE TABLE x (id INT PRIMARY KEY, v INT) ENGINE=TIDESDB TTL=4;
INSERT INTO written_at VALUES (UNIX_TIMESTAMP());
INSERT INTO x VALUES (1, 10), (2, 20);
ALTER TABLE x ADD INDEX kv (v), ALGORITHM=INPLACE;
--disable_result_log
SELECT SLEEP(GREATEST(0, t + 6 - UNIX_TIMESTAMP())) FROM written_at;
--enable_result_log
--echo # answered from the index alone, the expired rows must not appear
--replace_column 9 #
EXPLAIN SELECT v FROM x FORCE INDEX (kv) WHERE v > 0;
SELECT v FROM x FORCE INDEX (kv) WHERE v > 0;
SELECT COUNT(*) FROM x;
DROP TABLE x, written_at;

--source include/cleanup_tidesdb.inc
