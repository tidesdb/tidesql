CREATE TABLE p (id INT PRIMARY KEY, code INT NOT NULL UNIQUE) ENGINE=TIDESDB;
CREATE TABLE c (id INT PRIMARY KEY, pid INT, KEY (pid),
FOREIGN KEY (pid) REFERENCES p (id)) ENGINE=TIDESDB;
CREATE TABLE cc (id INT PRIMARY KEY, pid INT, KEY (pid),
FOREIGN KEY (pid) REFERENCES p (id) ON DELETE CASCADE) ENGINE=TIDESDB;
INSERT INTO p VALUES (1, 100), (2, 200), (3, 300), (4, 400), (5, 500);
connect  con2, localhost, root,,;
#
# 1. The parent is being deleted when a child is inserted
#
connection default;
START TRANSACTION;
DELETE FROM p WHERE id = 1;
connection con2;
START TRANSACTION;
INSERT INTO c VALUES (10, 1);
ERROR 40001: Deadlock found when trying to get lock; try restarting transaction
ROLLBACK;
connection default;
COMMIT;
# retried after the delete, the parent is gone
connection con2;
INSERT INTO c VALUES (10, 1);
ERROR 23000: Cannot add or update a child row: a foreign key constraint fails (c_ibfk_1)
#
# 2. A child is being inserted when its parent is deleted
#
connection con2;
START TRANSACTION;
INSERT INTO c VALUES (20, 2);
connection default;
START TRANSACTION;
DELETE FROM p WHERE id = 2;
ERROR 40001: Deadlock found when trying to get lock; try restarting transaction
ROLLBACK;
connection con2;
COMMIT;
# retried after the insert, the parent is referenced
connection default;
DELETE FROM p WHERE id = 2;
ERROR 23000: Cannot delete or update a parent row: a foreign key constraint fails (c_ibfk_1)
#
# 3. The parent was deleted after the child's snapshot was taken
#
connection con2;
START TRANSACTION;
SELECT COUNT(*) FROM p;
COUNT(*)
4
connection default;
DELETE FROM p WHERE id = 3;
connection con2;
INSERT INTO c VALUES (30, 3);
ERROR 40001: Deadlock found when trying to get lock; try restarting transaction
ROLLBACK;
# retried with a fresh snapshot, the parent is gone
START TRANSACTION;
INSERT INTO c VALUES (30, 3);
ERROR 23000: Cannot add or update a child row: a foreign key constraint fails (c_ibfk_1)
ROLLBACK;
#
# 4. A child was added after the deleting transaction's snapshot was taken
#
connection default;
START TRANSACTION;
SELECT COUNT(*) FROM c;
COUNT(*)
1
connection con2;
INSERT INTO c VALUES (40, 4);
connection default;
DELETE FROM p WHERE id = 4;
ERROR 40001: Deadlock found when trying to get lock; try restarting transaction
ROLLBACK;
# retried with a fresh snapshot, the parent is referenced
START TRANSACTION;
DELETE FROM p WHERE id = 4;
ERROR 23000: Cannot delete or update a parent row: a foreign key constraint fails (c_ibfk_1)
ROLLBACK;
#
# 5. A cascading delete meets a child inserted alongside it
#
connection default;
START TRANSACTION;
DELETE FROM p WHERE id = 5;
connection con2;
START TRANSACTION;
INSERT INTO cc VALUES (50, 5);
ERROR 40001: Deadlock found when trying to get lock; try restarting transaction
connection default;
COMMIT;
connection con2;
ROLLBACK;
#
# 6. Two children of the same parent do not block each other
#
connection default;
START TRANSACTION;
INSERT INTO c VALUES (60, 4);
connection con2;
START TRANSACTION;
INSERT INTO c VALUES (61, 4);
COMMIT;
connection default;
COMMIT;
#
# No child is left without its parent
#
SELECT c.id, c.pid FROM c LEFT JOIN p ON p.id = c.pid WHERE p.id IS NULL;
id	pid
SELECT cc.id, cc.pid FROM cc LEFT JOIN p ON p.id = cc.pid WHERE p.id IS NULL;
id	pid
SELECT id, pid FROM c ORDER BY id;
id	pid
20	2
40	4
60	4
61	4
disconnect con2;
connection default;
DROP TABLE c, cc, p;
