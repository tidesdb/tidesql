#
# Collation-sensitive indexing.  The comparable sort key is built from
# Field::sort_string, which folds by the column's collation, so a
# case-insensitive UNIQUE index must collapse case variants while a
# binary/case-sensitive one keeps them distinct, and ORDER BY through
# the index must follow each collation.
#
#
# 1. Case-insensitive collation: 'abc' and 'ABC' collide in a UNIQUE
#    index and sort together.
#
CREATE TABLE ci (
id INT PRIMARY KEY,
name VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci,
UNIQUE KEY uq (name)
) ENGINE=TidesDB;
INSERT INTO ci VALUES (1, 'abc'), (2, 'XYZ'), (3, 'def');
INSERT INTO ci VALUES (4, 'ABC');
ERROR 23000: Duplicate entry 'ABC' for key 'uq'
INSERT INTO ci VALUES (5, 'xyz');
ERROR 23000: Duplicate entry 'xyz' for key 'uq'
# lookup is case-insensitive
SELECT id, name FROM ci FORCE INDEX (uq) WHERE name = 'AbC';
id	name
1	abc
# ordered scan through the ci index
SELECT id, name FROM ci FORCE INDEX (uq) ORDER BY name;
id	name
1	abc
3	def
2	XYZ
#
# 2. Binary collation keeps case variants distinct.
#
CREATE TABLE bin (
id INT PRIMARY KEY,
name VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin,
UNIQUE KEY uq (name)
) ENGINE=TidesDB;
INSERT INTO bin VALUES (1, 'abc'), (2, 'ABC'), (3, 'Abc');
SELECT COUNT(*) AS rows_expected_3 FROM bin;
rows_expected_3
3
# exact (case-sensitive) lookup
SELECT id FROM bin FORCE INDEX (uq) WHERE name = 'ABC';
id
2
# binary order: uppercase sorts before lowercase
SELECT id, name FROM bin FORCE INDEX (uq) ORDER BY name;
id	name
2	ABC
3	Abc
1	abc
#
# 3. Accent/case folding: a range scan honors the ci collation weights.
#
CREATE TABLE r (id INT PRIMARY KEY, w VARCHAR(16) COLLATE utf8mb4_general_ci, KEY k_w (w))
ENGINE=TidesDB;
INSERT INTO r VALUES (1, 'Apple'), (2, 'banana'), (3, 'Cherry'), (4, 'apple');
SELECT id, w FROM r FORCE INDEX (k_w) WHERE w BETWEEN 'a' AND 'c';
id	w
1	Apple
2	banana
4	apple
SELECT id, w FROM r FORCE INDEX (k_w) ORDER BY w, id;
id	w
1	Apple
4	apple
2	banana
3	Cherry
DROP TABLE ci, bin, r;
#
# Done.
