#
# Index-condition pushdown (ICP).  The engine advertises
# HA_DO_INDEX_COND_PUSHDOWN and evaluates the pushed predicate on the
# index entry before the primary-key row fetch.  A wrong pushed-condition
# evaluation would silently drop matching rows, so the pushed-down result
# must equal the same query with ICP turned off.
#
CREATE TABLE t (
id INT PRIMARY KEY,
a INT,
b INT,
c VARCHAR(20),
KEY k_ab (a, b)
) ENGINE=TidesDB;
INSERT INTO t VALUES
(1, 1, 10, 'apple'), (2, 1, 20, 'apricot'), (3, 1, 30, 'banana'),
(4, 2, 10, 'avocado'), (5, 2, 25, 'blueberry'), (6, 3, 15, 'cherry'),
(7, 3, 40, 'apple'), (8, 2, 20, 'almond');
# The predicate on the trailing index part (b) is pushable; c is not
# indexed and stays a table condition.
EXPLAIN SELECT id, a, b FROM t FORCE INDEX (k_ab) WHERE a = 2 AND b > 15;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t	range	k_ab	k_ab	10	NULL	#	Using where; Using index
#
# ICP on vs off must return identical rows.
#
SET @save_switch = @@optimizer_switch;
SET optimizer_switch = 'index_condition_pushdown=on';
SELECT id, a, b FROM t FORCE INDEX (k_ab) WHERE a = 2 AND b > 15;
id	a	b
5	2	25
8	2	20
SELECT id, a, b, c FROM t FORCE INDEX (k_ab) WHERE a IN (1, 3) AND b >= 30;
id	a	b	c
3	1	30	banana
7	3	40	apple
SET optimizer_switch = 'index_condition_pushdown=off';
SELECT id, a, b FROM t FORCE INDEX (k_ab) WHERE a = 2 AND b > 15;
id	a	b
5	2	25
8	2	20
SELECT id, a, b, c FROM t FORCE INDEX (k_ab) WHERE a IN (1, 3) AND b >= 30;
id	a	b	c
3	1	30	banana
7	3	40	apple
SET optimizer_switch = @save_switch;
#
# A pushed condition combined with a residual (non-indexed) predicate.
#
SELECT id FROM t FORCE INDEX (k_ab) WHERE a = 1 AND b < 30 AND c LIKE 'ap%';
id
1
2
DROP TABLE t;
#
# Done.
