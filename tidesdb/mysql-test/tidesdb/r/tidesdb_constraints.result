#
# Constraint and column-default behaviors over TidesDB tables: CHECK
# constraints, ON UPDATE CURRENT_TIMESTAMP, DEFAULT expressions, the
# accepted-but-not-enforced status of FOREIGN KEY, and descending key
# parts (stored ascending; the server sorts).
#
#
# 1. CHECK constraints are enforced on INSERT and UPDATE.
#
CREATE TABLE t1 (
id INT PRIMARY KEY,
age INT,
CONSTRAINT c_age CHECK (age >= 0)
) ENGINE=TidesDB;
INSERT INTO t1 VALUES (1, 20), (2, 0);
INSERT INTO t1 VALUES (3, -5);
ERROR 23000: CONSTRAINT `c_age` failed for `test`.`t1`
UPDATE t1 SET age = -1 WHERE id = 1;
ERROR 23000: CONSTRAINT `c_age` failed for `test`.`t1`
SELECT id, age FROM t1 ORDER BY id;
id	age
1	20
2	0
#
# 2. DEFAULT expression and ON UPDATE CURRENT_TIMESTAMP round-trip.
#
CREATE TABLE t2 (
id INT PRIMARY KEY,
v INT,
tag VARCHAR(8) DEFAULT (CONCAT('n', 'a')),
upd TIMESTAMP(6) DEFAULT CURRENT_TIMESTAMP(6) ON UPDATE CURRENT_TIMESTAMP(6)
) ENGINE=TidesDB;
INSERT INTO t2 (id, v) VALUES (1, 10);
SELECT id, v, tag FROM t2;
id	v	tag
1	10	na
# capture the timestamp, force time to advance, update, assert it moved
SET @t0 = (SELECT upd FROM t2 WHERE id = 1);
UPDATE t2 SET v = 11 WHERE id = 1;
SELECT (SELECT upd FROM t2 WHERE id = 1) > @t0 AS upd_advanced;
upd_advanced
1
#
# 3. FOREIGN KEY is enforced by the engine.  A child referencing a
#    missing parent is rejected; see tidesdb_foreign_keys for the full
#    coverage of restrict, cascade, and set null.
#
CREATE TABLE fk_parent (id INT PRIMARY KEY) ENGINE=TidesDB;
CREATE TABLE fk_child (
id INT PRIMARY KEY,
pid INT,
FOREIGN KEY (pid) REFERENCES fk_parent (id)
) ENGINE=TidesDB;
INSERT INTO fk_parent VALUES (1);
# a child referencing a non-existent parent is now rejected
INSERT INTO fk_child VALUES (10, 999);
ERROR 23000: Cannot add or update a child row: a foreign key constraint fails (fk_child_ibfk_1)
INSERT INTO fk_child VALUES (10, 1);
SELECT id, pid FROM fk_child ORDER BY id;
id	pid
10	1
#
# 4. Descending key part KEY(v DESC): the comparable sort key stores the
#    part byte-inverted so a forward index walk yields descending order,
#    NULLs sort last, and range scans and covering reads are correct.
#
CREATE TABLE t4 (id INT PRIMARY KEY, v INT, KEY k_desc (v DESC)) ENGINE=TidesDB;
INSERT INTO t4 VALUES (1, 30), (2, 10), (3, 20), (4, 40), (5, NULL);
# DESC: values descending, NULL last
SELECT v FROM t4 FORCE INDEX (k_desc) ORDER BY v DESC;
v
40
30
20
10
NULL
# ASC: NULL first, then ascending
SELECT v FROM t4 FORCE INDEX (k_desc) ORDER BY v ASC;
v
NULL
10
20
30
40
# range and covering read through the descending index
SELECT v FROM t4 FORCE INDEX (k_desc) WHERE v > 15;
v
20
30
40
SELECT id FROM t4 FORCE INDEX (k_desc) WHERE v = 20;
id
3
DROP TABLE t1, t2, fk_child, fk_parent, t4;
#
# Done.
