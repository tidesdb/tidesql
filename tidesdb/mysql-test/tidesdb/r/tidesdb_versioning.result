#
# System-versioned tables on ENGINE=TidesDB.  The server manages the
# row_start/row_end period columns and history; the engine stores them
# as ordinary columns via its self-describing row format.  This checks
# that current-version queries and history queries return the right
# rows across INSERT / UPDATE / DELETE.
#
CREATE TABLE t (
id INT PRIMARY KEY,
v INT
) WITH SYSTEM VERSIONING ENGINE=TidesDB;
INSERT INTO t VALUES (1, 10), (2, 20), (3, 30);
# current view: 3 live rows
SELECT id, v FROM t ORDER BY id;
id	v
1	10
2	20
3	30
# update creates a historical version of id=1
UPDATE t SET v = 11 WHERE id = 1;
# delete makes id=3 historical
DELETE FROM t WHERE id = 3;
# current view: id=1 updated, id=3 gone
SELECT id, v FROM t ORDER BY id;
id	v
1	11
2	20
# full history (current + historical) sees every version:
#   id=1 v=10 (old) and v=11 (current), id=2 v=20, id=3 v=30 (deleted)
SELECT id, v FROM t FOR SYSTEM_TIME ALL ORDER BY id, v;
id	v
1	10
1	11
2	20
3	30
# count of historical (non-current) rows = 2 (old id=1, deleted id=3)
SELECT COUNT(*) AS history_expected_2
FROM t FOR SYSTEM_TIME ALL
WHERE row_end < '2038-01-01 00:00:00';
history_expected_2
2
DROP TABLE t;
#
# Done.
