#
# SHOW ENGINE TIDESDB STATUS should return output
#
CREATE TABLE t1 (id INT PRIMARY KEY, val INT) ENGINE=TidesDB;
INSERT INTO t1 VALUES (1,10),(2,20),(3,30);
SHOW ENGINE TIDESDB STATUS;
Type	Name	Status
TIDESDB		================== TidesDB Engine Status ==================
