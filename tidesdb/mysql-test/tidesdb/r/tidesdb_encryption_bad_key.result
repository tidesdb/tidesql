call mtr.add_suppression("\\[TIDESDB\\] encryption_crypt\\(decrypt\\) failed");
call mtr.add_suppression("\\[TIDESDB\\] encryption_key_get failed");
call mtr.add_suppression("\\[TIDESDB\\] could not decrypt the last row");
call mtr.add_suppression("Got error 192");
CREATE TABLE t1 (id INT PRIMARY KEY, v VARCHAR(20), n INT) ENGINE=TIDESDB ENCRYPTED=YES ENCRYPTION_KEY_ID=2;
INSERT INTO t1 VALUES (1,'one',10),(2,'two',20),(3,'three',30),(4,'four',40),(5,'five',50),
(6,'six',60),(7,'seven',70),(8,'eight',80),(9,'nine',90),(10,'ten',100),
(11,'eleven',110),(12,'twelve',120),(13,'thirteen',130),(14,'fourteen',140),
(15,'fifteen',150),(16,'sixteen',160);
SELECT COUNT(*), SUM(n) FROM t1;
COUNT(*)	SUM(n)
16	1360
# restart with a key file whose key id 2 has different bytes
# restart: --file-key-management-filename=MYSQL_TEST_DIR/std_data/keys.txt
# a full scan fails instead of returning zeroed rows
SELECT * FROM t1;
ERROR HY000: Got error 192 "Table encrypted but decryption failed. This could be because correct encryption management plugin is not loaded, used encryptio" from storage engine TidesDB
# a primary key point read fails too
SELECT * FROM t1 WHERE id = 7;
ERROR HY000: Got error 192 "Table encrypted but decryption failed. This could be because correct encryption management plugin is not loaded, used encryptio" from storage engine TidesDB
# an in-place index build stops instead of indexing zeroed rows
ALTER TABLE t1 ADD INDEX iv (v), ALGORITHM=INPLACE;
ERROR HY000: Internal error: [TIDESDB] a row could not be decrypted during index build
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int(11) NOT NULL,
  `v` varchar(20) DEFAULT NULL,
  `n` int(11) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=TidesDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci `ENCRYPTED`='YES' `ENCRYPTION_KEY_ID`='2'
# restore the original key file, the rows read back unchanged
# restart: --file-key-management-filename=MYSQL_TEST_DIR/std_data/keys2.txt
SELECT COUNT(*), SUM(n) FROM t1;
COUNT(*)	SUM(n)
16	1360
SELECT * FROM t1 WHERE id = 7;
id	v	n
7	seven	70
DROP TABLE t1;
