#
# ============================================
# Changing only the primary key re-keys FULLTEXT and SPATIAL entries
# ============================================
#
CREATE TABLE f (id INT PRIMARY KEY, body TEXT, geo GEOMETRY NOT NULL,
FULLTEXT KEY fb (body), SPATIAL KEY sg (geo)) ENGINE=TIDESDB;
INSERT INTO f VALUES (1,'hello tidal world', ST_GeomFromText('POINT(1 1)')),
(2,'other text here',  ST_GeomFromText('POINT(9 9)'));
UPDATE f SET id = 100 WHERE id = 1;
SELECT id FROM f WHERE MATCH(body) AGAINST('tidal');
id
100
SELECT id FROM f WHERE MATCH(body) AGAINST('+tidal' IN BOOLEAN MODE);
id
100
SELECT id FROM f FORCE INDEX (sg)
WHERE MBRWithin(geo, ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'));
id
100
# the old key taken by another row brings no stale match with it
INSERT INTO f VALUES (1,'completely unrelated', ST_GeomFromText('POINT(50 50)'));
SELECT id, body FROM f WHERE MATCH(body) AGAINST('tidal');
id	body
100	hello tidal world
SELECT id FROM f FORCE INDEX (sg)
WHERE MBRWithin(geo, ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'));
id
100
SELECT id FROM f WHERE MATCH(body) AGAINST('unrelated');
id
1
DROP TABLE f;
#
# ============================================
# An update refreshes the expiry of every index entry, not just the row
# ============================================
#
CREATE TABLE t (id INT PRIMARY KEY, k INT, v VARCHAR(20), body TEXT, geo GEOMETRY NOT NULL,
KEY ik (k), FULLTEXT KEY fb (body), SPATIAL KEY sg (geo)) ENGINE=TIDESDB TTL=6;
INSERT INTO t VALUES (1,10,'a','tidal pool',ST_GeomFromText('POINT(1 1)')),
(2,20,'b','other words',ST_GeomFromText('POINT(9 9)'));
SELECT SLEEP(3);
UPDATE t SET v = 'a2' WHERE id = 1;
# past the original deadline, before the refreshed one
SELECT SLEEP(4);
SELECT id, k, v FROM t WHERE id = 1;
id	k	v
1	10	a2
SELECT id FROM t FORCE INDEX (ik) WHERE k = 10;
id
1
SELECT id FROM t WHERE MATCH(body) AGAINST('tidal');
id
1
SELECT id FROM t FORCE INDEX (sg)
WHERE MBRWithin(geo, ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'));
id
1
# the row that was not updated has expired everywhere
SELECT COUNT(*) FROM t WHERE id = 2;
COUNT(*)
0
SELECT COUNT(*) FROM t FORCE INDEX (ik) WHERE k = 20;
COUNT(*)
0
DROP TABLE t;
#
# ============================================
# A session TTL on a table without one, cleared by a later update
# ============================================
#
# The row's old expiry cannot be read back, so once a session TTL has written to the table
# every update rewrites the row's index entries too, also after a restart.
CREATE TABLE s (id INT PRIMARY KEY, k INT, v VARCHAR(10), KEY ik (k)) ENGINE=TIDESDB;
SET SESSION tidesdb_ttl = 4;
INSERT INTO s VALUES (1, 10, 'a'), (2, 20, 'b');
SET SESSION tidesdb_ttl = 0;
UPDATE s SET v = 'a2' WHERE id = 1;
# restart
UPDATE s SET v = 'b2' WHERE id = 2;
SELECT SLEEP(6);
SELECT id, k, v FROM s ORDER BY id;
id	k	v
1	10	a2
2	20	b2
SELECT id FROM s FORCE INDEX (ik) WHERE k IN (10, 20) ORDER BY id;
id
1
2
DROP TABLE s;
