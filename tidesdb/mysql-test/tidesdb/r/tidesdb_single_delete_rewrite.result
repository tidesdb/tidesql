CREATE TABLE t (id INT PRIMARY KEY, k INT, v VARCHAR(20), body TEXT, geo GEOMETRY NOT NULL,
KEY ik (k), FULLTEXT KEY fb (body), SPATIAL KEY sg (geo)) ENGINE=TIDESDB TTL=3600;
INSERT INTO t VALUES (1,10,'a','tidal pool',ST_GeomFromText('POINT(1 1)')),
(2,20,'b','tidal flat',ST_GeomFromText('POINT(1 2)'));
# rewrite every index entry in place, the expiry refresh and a longer document
UPDATE t SET v = 'a2', body = 'tidal pool deep' WHERE id = 1;
UPDATE t SET v = 'b2' WHERE id = 2;
# delete one row, its entries get single-deletes
DELETE FROM t WHERE id = 1;
OPTIMIZE TABLE t;
OPTIMIZE TABLE t;
SELECT id FROM t ORDER BY id;
id
2
SELECT id FROM t FORCE INDEX (ik) WHERE k IN (10, 20) ORDER BY id;
id
2
SELECT id FROM t WHERE MATCH(body) AGAINST('tidal') ORDER BY id;
id
2
SELECT id FROM t WHERE MATCH(body) AGAINST('deep');
id
SELECT id FROM t FORCE INDEX (sg)
WHERE MBRWithin(geo, ST_GeomFromText('POLYGON((0 0,3 0,3 3,0 3,0 0))')) ORDER BY id;
id
2
