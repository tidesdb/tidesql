# TidesDB in a two-node Galera cluster.  The engine advertises
# HTON_WSREP_REPLICATION and appends a certification key for every row it writes,
# so a transaction on one node replicates through the provider and applies on the
# other.  This exercises that path both directions: schema, a spread of column
# types, a secondary index driven on the apply side, and a byte-for-byte checksum
# comparison across the two nodes.
--source include/galera_cluster.inc
--source include/have_innodb.inc

call mtr.add_suppression("Plugin 'TIDESDB' is of maturity level");
--connection node_2
call mtr.add_suppression("Plugin 'TIDESDB' is of maturity level");
--connection node_1

--echo #
--echo # 1. A TidesDB table created on one node exists on the other.
--echo #
CREATE TABLE t1 (id INT PRIMARY KEY, v VARCHAR(32), KEY k_v (v)) ENGINE=TidesDB;

--connection node_2
SHOW CREATE TABLE t1;

--echo #
--echo # 2. Rows written on node 1 apply on node 2.
--echo #
--connection node_1
INSERT INTO t1 VALUES (1, 'one'), (2, 'two'), (3, 'three');

--connection node_2
SELECT id, v FROM t1 ORDER BY id;
--echo # the replicated secondary index answers a covered lookup on node 2
SELECT id FROM t1 FORCE INDEX (k_v) WHERE v = 'two';

--echo #
--echo # 3. Writes on node 2 apply back on node 1.
--echo #
--connection node_2
INSERT INTO t1 VALUES (4, 'four');
UPDATE t1 SET v = 'ONE' WHERE id = 1;
DELETE FROM t1 WHERE id = 3;

--connection node_1
SELECT id, v FROM t1 ORDER BY id;

--echo #
--echo # 4. A wider column set with NULLs replicates and applies.
--echo #
--connection node_1
CREATE TABLE t2 (
  id INT PRIMARY KEY,
  i64 BIGINT, d DECIMAL(20,6), f DOUBLE,
  c CHAR(8), v VARCHAR(64), t TEXT, b BLOB,
  dt DATETIME(3), y YEAR, e ENUM('a','b','c'),
  KEY k_d (d)
) ENGINE=TidesDB;
INSERT INTO t2 VALUES
 (1, 9000000000, 12345.678900, 3.5, 'char', 'varchar', 'text-a', 0x0102,
  '2023-01-02 03:04:05.678', 2021, 'b'),
 (2, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
UPDATE t2 SET d = 99999.999999, e = 'c' WHERE id = 1;

--connection node_2
SELECT id, i64, d, f, c, v, e FROM t2 ORDER BY id;
SELECT id FROM t2 FORCE INDEX (k_d) WHERE d > 100 ORDER BY id;

--echo #
--echo # 5. A larger multi-statement transaction replicates atomically.
--echo #
--connection node_1
BEGIN;
--disable_query_log
let $i= 1;
while ($i <= 100) {
  eval INSERT INTO t1 VALUES (1000 + $i, CONCAT('row', $i));
  inc $i;
}
--enable_query_log
COMMIT;

--connection node_2
SELECT COUNT(*) AS total, SUM(id) AS sum_id FROM t1;

--echo #
--echo # 6. Both nodes hold byte-for-byte identical tables.
--echo #
--connection node_1
--let $c1t1= query_get_value(CHECKSUM TABLE t1 EXTENDED, Checksum, 1)
--let $c1t2= query_get_value(CHECKSUM TABLE t2 EXTENDED, Checksum, 1)
--connection node_2
--let $c2t1= query_get_value(CHECKSUM TABLE t1 EXTENDED, Checksum, 1)
--let $c2t2= query_get_value(CHECKSUM TABLE t2 EXTENDED, Checksum, 1)
if ($c1t1 == $c2t1) {
  --echo # t1 extended checksums match on node 1 and node 2
}
if ($c1t1 != $c2t1) {
  --echo MISMATCH t1 node1=$c1t1 node2=$c2t1
}
if ($c1t2 == $c2t2) {
  --echo # t2 extended checksums match on node 1 and node 2
}
if ($c1t2 != $c2t2) {
  --echo MISMATCH t2 node1=$c1t2 node2=$c2t2
}

--connection node_1
DROP TABLE t1, t2;

--source include/galera_end.inc
