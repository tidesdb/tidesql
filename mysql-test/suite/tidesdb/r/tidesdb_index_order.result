#
# Secondary-index ordering edge cases that a filesort would otherwise
# mask: forward and backward index-provided order, NULL placement in
# index order, partial composite-key ranges, and duplicate-key walking
# via index_next_same.
#
CREATE TABLE t (id INT PRIMARY KEY, k INT, KEY k_idx (k)) ENGINE=TidesDB;
INSERT INTO t VALUES
(1, 30), (2, 10), (3, 20), (4, 10), (5, 30), (6, 20), (7, 10);
#
# 1. Ascending and descending order delivered by the index.
#    A covering read keeps the plan index-only so the order comes from
#    the index walk (index_next / index_prev), not a filesort.
#
EXPLAIN SELECT k FROM t FORCE INDEX (k_idx) ORDER BY k;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t	index	NULL	k_idx	5	NULL	#	Using index
SELECT k FROM t FORCE INDEX (k_idx) ORDER BY k;
k
10
10
10
20
20
30
30
EXPLAIN SELECT k FROM t FORCE INDEX (k_idx) ORDER BY k DESC;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	t	index	NULL	k_idx	5	NULL	#	Using index
SELECT k FROM t FORCE INDEX (k_idx) ORDER BY k DESC;
k
30
30
20
20
10
10
10
#
# 2. index_next_same: all rows sharing one secondary key, in the
#    index's natural (pk-ascending) order, terminating at the prefix.
#
SELECT id, k FROM t FORCE INDEX (k_idx) WHERE k = 10;
id	k
2	10
4	10
7	10
#
# 3. NULL ordering through the index: NULLs sort first ascending,
#    last descending.
#
CREATE TABLE n (id INT PRIMARY KEY, v INT, KEY k_v (v)) ENGINE=TidesDB;
INSERT INTO n VALUES (1, 5), (2, NULL), (3, 1), (4, NULL), (5, 3);
SELECT id, v FROM n FORCE INDEX (k_v) ORDER BY v;
id	v
2	NULL
4	NULL
3	1
5	3
1	5
SELECT id, v FROM n FORCE INDEX (k_v) ORDER BY v DESC;
id	v
1	5
5	3
3	1
4	NULL
2	NULL
#
# 4. Composite key partial-range scans: leading-equal + trailing range,
#    and open/closed bounds.
#
CREATE TABLE c (id INT PRIMARY KEY, a INT, b INT, KEY k_ab (a, b)) ENGINE=TidesDB;
INSERT INTO c VALUES
(1, 1, 5), (2, 1, 10), (3, 1, 15), (4, 2, 5), (5, 2, 10), (6, 3, 1);
# a = 2 AND b > 5 must exclude a=1 and a=3 rows entirely
SELECT id, a, b FROM c FORCE INDEX (k_ab) WHERE a = 2 AND b > 5 ORDER BY a, b;
id	a	b
5	2	10
# leading part range
SELECT id, a, b FROM c FORCE INDEX (k_ab) WHERE a >= 2 ORDER BY a, b;
id	a	b
4	2	5
5	2	10
6	3	1
# closed range on the trailing part
SELECT id, a, b FROM c FORCE INDEX (k_ab) WHERE a = 1 AND b BETWEEN 10 AND 15 ORDER BY a, b;
id	a	b
2	1	10
3	1	15
DROP TABLE t, n, c;
#
# Done.
