#
# Partitioning depth: prune proof via EXPLAIN PARTITIONS, a row that
# moves partitions when its partitioning key is UPDATEd, uniqueness
# enforced across partitions, and auto-increment under partitioning.
#
#
# 1. Partition pruning actually restricts the scanned partitions.
#
CREATE TABLE p (
id INT,
v INT,
PRIMARY KEY (id)
) ENGINE=TidesDB
PARTITION BY RANGE (id) (
PARTITION p0 VALUES LESS THAN (10),
PARTITION p1 VALUES LESS THAN (20),
PARTITION p2 VALUES LESS THAN (30),
PARTITION p3 VALUES LESS THAN MAXVALUE
);
INSERT INTO p VALUES (1,1),(5,5),(12,12),(18,18),(22,22),(28,28),(35,35);
# only p1 should be scanned for id in [10,20)
EXPLAIN PARTITIONS SELECT * FROM p WHERE id >= 10 AND id < 20;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	p	p1	range	PRIMARY	PRIMARY	4	NULL	2	Using where
SELECT * FROM p WHERE id >= 10 AND id < 20;
id	v
12	12
18	18
# a point lookup prunes to a single partition
EXPLAIN PARTITIONS SELECT * FROM p WHERE id = 22;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	p	p2	const	PRIMARY	PRIMARY	4	const	1	
#
# 2. UPDATE of the partitioning key relocates the row (p0 -> p3).
#
UPDATE p SET id = 99 WHERE id = 5;
EXPLAIN PARTITIONS SELECT * FROM p WHERE id = 99;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	p	p3	const	PRIMARY	PRIMARY	4	const	1	
SELECT * FROM p WHERE id = 99;
id	v
99	5
# the old key is gone
SELECT COUNT(*) AS gone_expected_0 FROM p WHERE id = 5;
gone_expected_0
0
SELECT id FROM p;
id
1
12
18
22
28
35
99
#
# 3. UNIQUE enforced across partitions (the unique key contains the
#    partitioning column, as MariaDB requires).
#
CREATE TABLE pu (
id INT,
code INT,
PRIMARY KEY (id),
UNIQUE KEY uq (id, code)
) ENGINE=TidesDB
PARTITION BY HASH (id) PARTITIONS 4;
INSERT INTO pu VALUES (1,100),(2,100),(5,100),(9,100);
INSERT INTO pu VALUES (1,200);
ERROR 23000: Duplicate entry '1' for key 'PRIMARY'
SELECT id, code FROM pu;
id	code
1	100
2	100
5	100
9	100
#
# 4. AUTO_INCREMENT on a partitioned table stays monotonic across
#    partitions.
#
CREATE TABLE pa (
id INT AUTO_INCREMENT,
v INT,
PRIMARY KEY (id)
) ENGINE=TidesDB
PARTITION BY HASH (id) PARTITIONS 4;
INSERT INTO pa (v) VALUES (10),(20),(30),(40),(50);
SELECT id, v FROM pa ORDER BY id;
id	v
1	10
2	20
3	30
4	40
5	50
SELECT COUNT(DISTINCT id) AS distinct_ids_expected_5 FROM pa;
distinct_ids_expected_5
5
#
# 5. TRUNCATE PARTITION empties one partition, leaves the rest.
#
ALTER TABLE p TRUNCATE PARTITION p2;
SELECT id FROM p;
id
1
12
18
35
99
DROP TABLE p, pu, pa;
#
# Done.
