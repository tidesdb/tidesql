call mtr.add_suppression("\\[TIDESDB\\].*TDB_ERR_CONFLICT");
CREATE TABLE u (
id  INT PRIMARY KEY,
v   INT NOT NULL
) ENGINE=TidesDB;
INSERT INTO u VALUES (1, 100);
connect  a, localhost, root,,;
connect  b, localhost, root,,;
#
# Scenario 1, a single transaction reads then writes the same row.
#
connection a;
SET SESSION transaction_isolation = 'REPEATABLE-READ';
BEGIN;
SELECT v FROM u WHERE id = 1;
v
100
UPDATE u SET v = v + 10 WHERE id = 1;
COMMIT;
connection default;
# 100 + 10 = 110
SELECT * FROM u WHERE id = 1;
id	v
1	110
#
# Scenario 2, two transactions read the row, then one writes it.  The
#         plain reads take no lock, so the write acquires X and commits
#         -- no upgrade, no deadlock.
#
connection a;
SET SESSION transaction_isolation = 'REPEATABLE-READ';
BEGIN;
SELECT v FROM u WHERE id = 1;
v
110
connection b;
SET SESSION transaction_isolation = 'REPEATABLE-READ';
BEGIN;
SELECT v FROM u WHERE id = 1;
v
110
connection a;
UPDATE u SET v = v + 1 WHERE id = 1;
COMMIT;
connection b;
COMMIT;
connection default;
# 110 + 1 = 111
SELECT * FROM u WHERE id = 1;
id	v
1	111
disconnect a;
disconnect b;
connection default;
DROP TABLE u;
# Done.
