#
# Triggers over TidesDB tables.  A trigger re-enters the handler to do
# DML on other TidesDB tables (and to mutate NEW) while the driving
# statement is mid-flight, so this exercises nested handler use, the
# per-connection transaction shared across handlers, auto-increment
# inside a trigger, and statement-atomic rollback when a trigger fails.
#
CREATE TABLE orders (id INT PRIMARY KEY, sku INT, qty INT) ENGINE=TidesDB;
CREATE TABLE stock (sku INT PRIMARY KEY, on_hand INT) ENGINE=TidesDB;
CREATE TABLE audit (aid INT PRIMARY KEY AUTO_INCREMENT, order_id INT, old_qty INT, new_qty INT)
ENGINE=TidesDB;
INSERT INTO stock VALUES (100, 50), (200, 50);
# BEFORE INSERT clamps qty; AFTER INSERT decrements stock and logs.
CREATE TRIGGER trg_bi BEFORE INSERT ON orders FOR EACH ROW
SET NEW.qty = IF(NEW.qty < 0, 0, NEW.qty);
CREATE TRIGGER trg_ai AFTER INSERT ON orders FOR EACH ROW
BEGIN
UPDATE stock SET on_hand = on_hand - NEW.qty WHERE sku = NEW.sku;
INSERT INTO audit (order_id, old_qty, new_qty) VALUES (NEW.id, NULL, NEW.qty);
END|
CREATE TRIGGER trg_au AFTER UPDATE ON orders FOR EACH ROW
BEGIN
UPDATE stock SET on_hand = on_hand - (NEW.qty - OLD.qty) WHERE sku = NEW.sku;
INSERT INTO audit (order_id, old_qty, new_qty) VALUES (NEW.id, OLD.qty, NEW.qty);
END|
CREATE TRIGGER trg_ad AFTER DELETE ON orders FOR EACH ROW
BEGIN
UPDATE stock SET on_hand = on_hand + OLD.qty WHERE sku = OLD.sku;
INSERT INTO audit (order_id, old_qty, new_qty) VALUES (OLD.id, OLD.qty, NULL);
END|
# Multi-row INSERT fires the BEFORE (clamp) and AFTER (stock+audit) triggers.
INSERT INTO orders VALUES (1, 100, 5), (2, 100, -3), (3, 200, 10);
# order 2's qty was clamped from -3 to 0
SELECT id, sku, qty FROM orders ORDER BY id;
id	sku	qty
1	100	5
2	100	0
3	200	10
# stock 100 down by 5+0, stock 200 down by 10
SELECT sku, on_hand FROM stock ORDER BY sku;
sku	on_hand
100	45
200	40
UPDATE orders SET qty = qty + 2 WHERE id = 1;
DELETE FROM orders WHERE id = 3;
SELECT sku, on_hand FROM stock ORDER BY sku;
sku	on_hand
100	43
200	50
# audit has: 3 inserts, 1 update, 1 delete = 5 rows, auto-inc contiguous
SELECT aid, order_id, old_qty, new_qty FROM audit ORDER BY aid;
aid	order_id	old_qty	new_qty
1	1	NULL	5
2	2	NULL	0
3	3	NULL	10
4	1	5	7
5	3	10	NULL
#
# A trigger that violates a unique constraint rolls the whole statement
# back atomically -- the driving INSERT and the trigger's effects both undo.
#
CREATE TABLE uniq_log (k INT PRIMARY KEY) ENGINE=TidesDB;
INSERT INTO uniq_log VALUES (1);
CREATE TRIGGER trg_fail AFTER INSERT ON stock FOR EACH ROW
INSERT INTO uniq_log VALUES (1);
INSERT INTO stock VALUES (300, 5);
ERROR 23000: Duplicate entry '1' for key 'PRIMARY'
# neither the stock row nor a uniq_log row was added
SELECT COUNT(*) AS stock_expected_2 FROM stock;
stock_expected_2
2
SELECT COUNT(*) AS uniq_log_expected_1 FROM uniq_log;
uniq_log_expected_1
1
DROP TRIGGER trg_fail;
DROP TABLE orders, stock, audit, uniq_log;
#
# Done.
