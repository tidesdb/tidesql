--source include/have_tidesdb.inc

--echo #
--echo # External XA (two-phase commit) on a single running server.
--echo #
--echo # Exercises the handlerton XA surface wired in ha_tidesdb_txn.cc:
--echo # XA PREPARE durably prepares the transaction's write batch under its
--echo # XID, XA COMMIT / XA ROLLBACK resolve it, and XA RECOVER lists the
--echo # transactions that are prepared but not yet decided.  A committed XID
--echo # keeps its rows and a rolled-back one leaves none.
--echo #

CREATE TABLE xa_t (id INT PRIMARY KEY, v VARCHAR(32)) ENGINE=TidesDB;

--echo #
--echo # 1. XA COMMIT keeps the prepared rows.
--echo #
XA START 'x1';
INSERT INTO xa_t VALUES (1, 'one'), (2, 'two');
XA END 'x1';
XA PREPARE 'x1';
XA COMMIT 'x1';
SELECT * FROM xa_t ORDER BY id;

--echo #
--echo # 2. XA ROLLBACK discards the prepared rows.
--echo #
XA START 'x2';
INSERT INTO xa_t VALUES (3, 'three');
XA END 'x2';
XA PREPARE 'x2';
XA ROLLBACK 'x2';
SELECT * FROM xa_t ORDER BY id;

--echo #
--echo # 3. XA RECOVER lists a prepared-but-undecided transaction, and it
--echo #    disappears once decided.
--echo #
XA START 'x3';
INSERT INTO xa_t VALUES (4, 'four');
XA END 'x3';
XA PREPARE 'x3';
--echo # expect one in-doubt transaction with gtrid 'x3'
XA RECOVER;
XA COMMIT 'x3';
--echo # expect no in-doubt transactions
XA RECOVER;
SELECT * FROM xa_t ORDER BY id;

DROP TABLE xa_t;

--echo #
--source include/cleanup_tidesdb.inc
--echo # Done.
